# Third-party and user-supplied paper full text stays local.
# Public metadata, BibTeX, notes, and verified links remain tracked.
/02_literature/papers/**/*.pdf
/02_literature/user_supplied_originals/**/*.pdf
# Explicitly included sample paper at the user's request.
!/02_literature/user_supplied_originals/MouEtAl2024_HiSim_2024.findings-acl.285.pdf

# Local SocioVerse2 checkout; reproducible origin/commit recorded by the study runner.
/04_code/third_party_reference/SocioVerse2/

# Local analysis scratch; never commit.
/tmp/

# Nested independent contest repo (own .git history; holds restricted inputs/outputs).
/04_code/implementation/socioverse2-contest/

# Experiment configs/results/logs embed restricted population data and per-agent traces.
# Covers all versions (v4/v5/v6/...), not only v4.
/06_experiments/

